# Public URL of this marketing website (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host port exposed by Docker Compose
PORT=3000

# Hospital Express API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Portal sign-in URL. Use an absolute URL only when the portal is hosted separately.
NEXT_PUBLIC_APP_LOGIN_URL=/signin
